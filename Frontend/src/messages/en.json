  "features": {
    "eyebrow": "Platform Capabilities",
    "titleParts": {
      "before": "Accuracy at Every",
      "accent": "Entry",
      "after": ""
    },
    "intro": "From master data to financial statements — Furnova enforces accounting rules at the database level, so the numbers you report are the numbers you can defend.",
    "badge": {
      "value": "8 Modules",
      "label": "One Ledger"
    },
    "items": {
      "multiAgent": {
        "title": "Automatic Double-Entry",
        "description": "Confirm a vendor bill or post a customer invoice and the matching journal entry is generated for you — debits and credits balanced, tax posted to its own account, never lumped into income."
      },
      "edgeAnalytics": {
        "title": "Real-Time Financial Reports",
        "description": "Balance Sheet, Profit & Loss and Budget Report are computed live from posted entries. No overnight batch, no stale figures — select a period and read the current position."
      },
      "satelliteFusion": {
        "title": "Organization-Level Isolation",
        "description": "Every record belongs to exactly one organization. Contacts, products, ledgers and reports are scoped so no business can ever see another's books."
      },
      "adaptiveLoop": {
        "title": "Budget vs Actual Tracking",
        "description": "Tag transactions to an analytic account for a project, store or department, and the Budget Report compares planned against actual spend with live variance."
      }
    }
  },
  "howItWorks": {
    "eyebrow": "Process Flow",
    "titleParts": {
      "before": "From Entry to",
      "accent": "Statement",
      "after": ""
    },
    "intro": "Four steps take a real business event all the way through to an auditable financial statement — with no manual journal work in between.",
    "steps": {
      "ingestion": {
        "title": "Set Up Master Data",
        "description": "Add contacts (customers and vendors), products with prices and tax, your chart of accounts, journals and analytic accounts. Enter each fact once."
      },
      "analysis": {
        "title": "Record Transactions",
        "description": "Raise a purchase order, convert it to a vendor bill, create a sales order and generate the customer invoice — all built from your master data."
      },
      "fusion": {
        "title": "Auto Journal Entries",
        "description": "Every confirmed bill, invoice and payment posts a balanced journal entry: debtors, creditors, income, expense and tax each land in the right account."
      },
      "action": {
        "title": "Generate Reports",
        "description": "Select a period and read the Balance Sheet, Profit & Loss and Budget Report — computed directly from the posted ledger, ready to review or export."
      }
    }
  },
  "tech": {
    "eyebrow": "Technology Stack",
    "titleParts": {
      "before": "Built on",
      "accent": "Reliable",
      "after": "Web Infrastructure"
    },
    "intro": "PostgreSQL-backed transactional integrity, a modular Node.js API and a fast Next.js interface — the stack an accounting system needs when every write has to be exact."
  },
  "chipScene": {
    "eyebrow": "Core Architecture",
    "titleParts": {
      "before": "The",
      "accent": "Ledger Core",
      "after": "Behind Every Entry"
