# ===========================================
# Server
# ===========================================
NODE_ENV=development
PORT=5000

# ===========================================
# PostgreSQL
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ODOO_INDIA
DB_USER=postgres
DB_PASSWORD=your_password

# ===========================================
# Security — Passwords
# ===========================================
BCRYPT_ROUNDS=12
PASSWORD_PEPPER=your-strong-pepper-secret-change-this

# ===========================================
# Security — JWT (normal users only)
# ===========================================
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRES_IN=15m

# ===========================================
# Security — Sessions (privileged users only)
# ===========================================
SESSION_SECRET=your-session-secret-change-this
SESSION_MAX_AGE_MS=1800000

# ===========================================
# Email — Gmail App Password
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=Management Software

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=http://localhost:3000

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ===========================================
# OTP
# ===========================================
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ===========================================
# CAPTCHA
# ===========================================
CAPTCHA_EXPIRES_MINUTES=5

# ===========================================
# Refresh Token (Remember Me)
# ===========================================
REFRESH_TOKEN_EXPIRES_DAYS=30


# ===========================================
# Payment gateway — Razorpay (project.md §10 Decision 3)
# ===========================================
# RAZORPAY_KEY_SECRET is a server-only secret. It must NEVER be given a
# NEXT_PUBLIC_ prefix and must never reach the frontend bundle — it is what
# signs and verifies payments, and a leaked secret makes every payment on the
# account forgeable.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_CURRENCY=INR
# Ceiling on a single order, in paise. 100000000 = ₹10,00,000.00
RAZORPAY_MAX_ORDER_PAISE=100000000
